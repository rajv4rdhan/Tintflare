# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# For production, set these as Worker secrets:
#   npx wrangler secret put B2_ACCOUNT_ID
#   npx wrangler secret put B2_APPLICATION_KEY
#   npx wrangler secret put B2_BUCKET_NAME

# Backblaze B2 application key ID (used as the Basic auth username).
# Note: this is the key ID, not the 12-digit account ID.
B2_ACCOUNT_ID=your_application_key_id

# Backblaze B2 application key.
B2_APPLICATION_KEY=your_application_key

# Bucket that stores the static site files.
B2_BUCKET_NAME=your_bucket_name
