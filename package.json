{
  "name": "tintflare",
  "version": "0.0.1",
  "private": true,
  "description": "A Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler secret bulk .env && wrangler deploy",
    "predeploy": "npm run typecheck && npm run build",
    "secrets": "wrangler secret bulk .env",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
