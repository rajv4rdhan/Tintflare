{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tintflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  // Exposes the deployed version ID. Themed SVGs key their edge cache and
  // ETag on it, so a deploy that changes the palette or transform takes effect.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
